@namespace GUI.Components.Pages
@page "/sheets"
@using System.Diagnostics
@using Microsoft.Extensions.AI
@using Microsoft.JSInterop
@rendermode InteractiveServer
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

@code {
    // Select cell A1 when page loads
    protected override void OnInitialized() {
        CellClicked(0, 0);
    }
}

<PageTitle>Spreadsheet</PageTitle>

<div>
    <!-- AI Chatbot -->
    <section id = "chatbot-container" style = "@_currentChatContainerStyle">
        <div id = "chatbot-interface" @ref="_chatPanelReference">
            <!-- AI History -->
            <ul id = "chatbot-history">
                @foreach (var msg in AIService.ChatHistory){
                    if (msg.Role == ChatRole.System || msg.Role == ChatRole.Tool) continue;
                    <li class = "@(msg.Role == Microsoft.Extensions.AI.ChatRole.User ? "chatbot-history-usermsg" : "chatbot-history-aimsg")" >@msg.Text</li>
                }

                @if (AIService.IsProcessing){ <li class = "chatbot-history-thinking">Thinking...</li> }
            </ul>

            <!-- User Input -->
            <div>
                <input 
                    id = "chatbot-user-input" 
                    placeholder="Type to use AI to edit your spreadsheet..."
                    disabled = "@AIService.IsProcessing" 
                    @bind = "UserInput" 
                    @onkeyup = "@(async (e) => { if (e.Key == "Enter") await SubmitChat(); })"
                />
                <button 
                    id = "chatbot-user-send" 
                    class = "main-button-style" 
                    disabled = "@AIService.IsProcessing" 
                    style = "cursor: @(AIService.IsProcessing ? "not-allowed" : "pointer");"
                    @onclick="SubmitChat"
                >
                    <svg viewBox = "0 0 195 195">
                        <use href = "images/send-icon.svg"/>
                    </svg>
                </button>
            </div>
        </div>
        <!-- Collapse button/tab -->
        <div id = "chatbot-collapse-tab"> 
            AI Assistant 

            <button class = "main-button-style" @onclick="CollapseAIChat">
                <svg viewBox = "0 0 512 512" style = "@_currentCollapseIconStyle">
                    <use href = "images/collapse-arrow.svg"/>
                </svg>
            </button>
        </div>
    </section>
    <br/>

    <!-- Save button -->
    <span>
        <button class="btn btn-primary" @onclick="SaveFile">Save</button>
        <label>Load</label>
        <InputFile type="file" OnChange="HandleFileChooser" />
    </span>

    <!-- Spreadsheet Table container -->
    <section class="table-container scrollable">
        <!-- Raw spreadsheet table -->
        <table class="table table-bordered">

            <!-- Table header -->
            <thead>
                <tr class="fixed-header">
                    <th scope="col">&nbsp;</th>
                    @for (int col = 0; col < COLS; col++) {
                        <th scope="col">@Alphabet[col]</th>
                    }
                </tr>
            </thead>

            <!-- Table body (the array of cells) -->
            <tbody>
                <!-- Constructing the spreadsheet cells based on internal ROWS and COLS constants -->
                @for (int row = 0; row < ROWS; row++) {
                    <tr style="padding:0 !important;">
                        <th style="padding:0; z-index: 6; !important;" scope="row" class="fixed-column">
                            @(row + 1)
                        </th>
                        @for (int col = 0; col < COLS; col++) {
                            int r = row;
                            int c = col;

                            <!-- Each spreadsheet cell here has a click event attached to it and other logistics -->
                            <td @onclick="() => CellClicked(r, c)" class='table-cell'>
                                <p class=@(_selectedCol == c && _selectedRow == r ? "spreadcell spreadcell-selected" : "spreadcell")> @CellsBackingStore[r, c] </p>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>


 <script type="text/javascript">
    function focusElement(id) {
        console.log(`looking for: ${id}`);
        var element = document.getElementById(id);
        if (element) {
            console.log(`focusing element: ${id} ${element}`)
            element.focus();
        }
    }

    window.addKeyPressListener = function (dotNetObject) {
        console.log("registering key press event handler");
        document.addEventListener('keydown', function (event) {
            console.log(`got key: ${event.key}`);
            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) {
                event.preventDefault(); // Prevent arrow keys from scrolling
            }
            dotNetObject.invokeMethodAsync('HandleKeyPress', event.key);
        });
    };

    // I added this because I needed to get the calculated height of a certain element for the
    // collapsing behavior of the AI agent panel.
    window.getElementHeight = function (element) {
        if (element) return element.getBoundingClientRect().height;
        return 0;
    }

    function downloadFile(fileName, fileContent) {
        console.log(`download file ${fileName}`);
        // Create a blob with the file content
        const blob = new Blob([fileContent], { type: "text/plain" });

        // Create a link element
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = fileName;
        // Append the anchor element to the body
        document.body.appendChild(a);

        // Click the link to trigger download
        a.click();

        // Remove the anchor element from the DOM
        document.body.removeChild(a);
    }

</script>
