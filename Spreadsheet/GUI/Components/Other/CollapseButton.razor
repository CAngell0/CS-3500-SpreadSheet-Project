@using GUI.Model

@code {
    // Sets the current direction to the default direction when the component loads
    protected override void OnParametersSet(){
        _currentDirection = DefaultDirection;
    }
}

<button class = "collapse-button @(Color.GetColorClass()) @(GetDirectionClass(_currentDirection))" @onclick = "OnClickHandler">
    <svg viewBox = "0 0 512 512" style = "@($"width: {Width}; height: {Height}")">
        <use href = "images/collapse-arrow.svg"/>
    </svg>
</button>

@code {
    /// <summary> Color scheme of the button. Uses its class value and isolated CSS to show it. </summary>
    [Parameter] public BasicColorOption Color { get; set; }
    /// <summary> Default direction that the collapse arrow should be facing. It will switch to its opposite direction when clicked. </summary>
    [Parameter] public Direction DefaultDirection { get; set; }
    /// <summary> Parameter to allow the caller of this component to add further onclick functionality </summary>
    [Parameter] public Action? OnClick { get; set; }
    /// <summary> Parameter to allow the caller of this component to add further onclick functionality. But allows asynchronous code instead </summary>
    [Parameter] public Func<Task>? OnClickAsync { get; set; }
    /// <summary> The value of this parameter is put into the button's style attribute. </summary>
    [Parameter] public string? Width { get; set; }
    /// <summary> The value of this parameter is put into the button's style attribute. </summary>
    [Parameter] public string? Height { get; set; }
    /// <summary> Keeps track of the current direction that the collapse arrow is pointing. This is updated when the button is clicked. </summary>
    private Direction _currentDirection;

    /// <summary>
    ///     Calls the OnClick function parameter along any other future functionality
    ///     the buttons may need.
    /// </summary>
    private async Task OnClickHandler(){
        // Call inputted onclick methods
        OnClick?.Invoke();
        if (OnClickAsync != null){
            var task = OnClickAsync.Invoke();
            await task;
        }

        // Update the direction
        _currentDirection = _currentDirection switch {
            Direction.Up => Direction.Down,
            Direction.Down => Direction.Up,
            Direction.Right => Direction.Left,
            Direction.Left => Direction.Right,
            _ => Direction.Up
        };
        StateHasChanged();
    }

    /// <summary>
    ///     Enum used to model the direction options for default direction and current direction.
    /// </summary>
    public enum Direction {
        Up, Down, Left, Right
    }

    /// <summary>
    ///     Helper method that takes a direction and returns its class form that's used for CSS.
    /// </summary>
    /// <param name="direction"> Direction to convert </param>
    /// <returns> The string version of the direction in the format "pointing-{direction}" </returns>
    public string GetDirectionClass(Direction direction){
        return direction switch {
            Direction.Up => "pointing-up",
            Direction.Down => "pointing-down",
            Direction.Left => "pointing-left",
            Direction.Right => "pointing-right",
            _ => "pointing-up"
        };
    }
}
