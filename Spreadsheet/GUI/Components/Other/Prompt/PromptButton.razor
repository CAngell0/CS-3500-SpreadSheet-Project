@namespace GUI.Components.Other.Prompt

<button class = "prompt-button" @onclick = "OnClickHandler">
    @ChildContent
</button>

<style>
    .prompt-button {
        margin-left: 0.5rem;

        border-radius: 3px;
        border: transparent;
        background-color: rgba(255, 255, 255, 0.577);
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        font-size: 0.9rem;
        
        transition: background-color 0.2s;
    }
    .prompt-button:hover {
        background-color: rgba(255, 255, 255, 0.809);
    }
    .prompt-button:active {
        background-color: rgba(255, 255, 255, 0.577);
    }
</style>

@code {
    /// <summary>
    ///     The text or icon that the button should contain. Or whatever elements you
    ///     want the inside of the button to have.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Action? OnClick { get; set; }

    /// <summary>
    ///     Calls the OnClick function parameter along any other future functionality
    ///     the buttons may need.
    /// </summary>
    private void OnClickHandler(){
        OnClick?.Invoke();
        // TODO - Add programming to remove prompt when button is pressed. 
    }
}
